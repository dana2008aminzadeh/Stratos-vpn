    <!-- comet on the ring -->
    <group android:rotation="-18" android:pivotX="48" android:pivotY="48">
        <path
            android:pathData="M63.0,36.0 L69.8,38.6"
            android:strokeColor="#DFF4FF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round" android:fillColor="#00000000" android:strokeAlpha="0.75" />
