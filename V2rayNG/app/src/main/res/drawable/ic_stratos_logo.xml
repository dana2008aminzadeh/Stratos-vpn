    <!-- planet -->
    <path android:pathData="M48,31.4a16.6,16.6 0 1,1 -0.02,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="34.5" android:startY="34.5" android:endX="63.5" android:endY="63.5">
                <item android:offset="0" android:color="#FF8BEFFF" />
                <item android:offset="0.45" android:color="#FF2E9EEB" />
                <item android:offset="1" android:color="#FF5846DC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- planet gloss -->
    <path android:pathData="M41.2,38.4m-5.6,0a5.6,4.2 0 1,1 11.2,0a5.6,4.2 0 1,1 -11.2,0"
        android:fillColor="#FFFFFF" android:fillAlpha="0.22" />

    <!-- metallic orbit ring (front half) -->
    <group android:rotation="-18" android:pivotX="48" android:pivotY="48">
        <path
            android:pathData="M78.4,48 A30.4,11.6 0 0 1 17.6,48"
            android:strokeColor="#F4F9FF"
            android:strokeWidth="3.6"
            android:strokeLineCap="round" android:fillColor="#00000000" />
