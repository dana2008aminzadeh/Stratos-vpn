    <!-- planet atmosphere -->
    <path android:pathData="M48,48m-18.6,0a18.6,18.6 0 1,1 37.2,0a18.6,18.6 0 1,1 -37.2,0"
        android:fillColor="#2E9EEB" android:fillAlpha="0.16" />

    <!-- metallic orbit ring (back half) -->
    <group android:rotation="-18" android:pivotX="48" android:pivotY="48">
        <path
            android:pathData="M78.4,48 A30.4,11.6 0 1 1 17.6,48 A30.4,11.6 0 1 1 78.4,48"
            android:strokeColor="#EAF5FF"
            android:strokeWidth="3.4"
            android:strokeLineCap="round" android:fillColor="#00000000" />
