<?xml version="1.0" encoding="utf-8"?>
<!-- Stratos VPN brand mark: aurora planet + metallic orbit ring (transparent background). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- stars -->
    <path android:pathData="M17.5,22.5m-1.05,0a1.05,1.05 0 1,1 2.1,0a1.05,1.05 0 1,1 -2.1,0" android:fillColor="#C8DCFF" />
    <path android:pathData="M79.2,19.4m-0.8,0a0.8,0.8 0 1,1 1.6,0a0.8,0.8 0 1,1 -1.6,0" android:fillColor="#AFC6F5" />
