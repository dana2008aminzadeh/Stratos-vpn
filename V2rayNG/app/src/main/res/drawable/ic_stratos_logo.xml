<?xml version="1.0" encoding="utf-8"?>
<!-- Stratos VPN brand mark v2 (transparent background): aurora orbits + luminous core. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <!-- outer aurora ring -->
    <group android:rotation="12" android:pivotX="48" android:pivotY="48">
        <path
            android:pathData="M85,48 A37,14 0 1 1 11,48 A37,14 0 1 1 85,48"
            android:strokeColor="#A78BFA"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
    <!-- mid orbit (behind) -->
    <group android:rotation="-26" android:pivotX="48" android:pivotY="48">
        <path
            android:pathData="M78,48 A30,11.5 0 1 1 18,48 A30,11.5 0 1 1 78,48"
            android:strokeColor="#22D3EE"
            android:strokeWidth="2.0"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
    <!-- planet core -->
    <path android:pathData="M48,31a17,17 0 1,1 -0.02,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="41"
                android:centerY="39"
                android:gradientRadius="22">
                <item android:offset="0" android:color="#FF7DD3FC" />
                <item android:offset="0.55" android:color="#FF38BDF8" />
                <item android:offset="1" android:color="#FF4F46E5" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- inner highlight -->
    <path android:pathData="M41,36.5a5,5 0 1,1 -0.01,0" android:fillColor="#BFFFFFFF" />
    <!-- front orbit -->
    <group android:rotation="-26" android:pivotX="48" android:pivotY="48">
        <path
            android:pathData="M78,48 A30,11.5 0 0 1 18,48"
            android:strokeColor="#67E8F9"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
    <!-- satellite -->
    <path
        android:pathData="M22,62.5m-3.2,0a3.2,3.2 0 1,1 6.4,0a3.2,3.2 0 1,1 -6.4,0"
        android:fillColor="#F5F3FF" />
    <!-- stars -->
    <path android:pathData="M18.2,24m-1.1,0a1.1,1.1 0 1,1 2.2,0a1.1,1.1 0 1,1 -2.2,0" android:fillColor="#DDD6FE" />
    <path android:pathData="M78.8,20m-0.9,0a0.9,0.9 0 1,1 1.8,0a0.9,0.9 0 1,1 -1.8,0" android:fillColor="#DDD6FE" />
    <path android:pathData="M71.4,79m-1.0,0a1.0,1.0 0 1,1 2.0,0a1.0,1.0 0 1,1 -2.0,0" android:fillColor="#DDD6FE" />
</vector>
