    <!-- planet atmosphere -->
    <path android:pathData="M54,54m-21,0a21,21 0 1,1 42,0a21,21 0 1,1 -42,0"
        android:fillColor="#2E9EEB" android:fillAlpha="0.16" />

    <!-- metallic orbit ring (back half) -->
    <group android:rotation="-18" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M88,54 A34,13 0 1 1 20,54 A34,13 0 1 1 88,54"
            android:strokeColor="#EAF5FF"
            android:strokeWidth="3.8"
            android:strokeLineCap="round" android:fillColor="#00000000" />
    </group>

    <!-- planet -->
    <path android:pathData="M54,35.4a18.6,18.6 0 1,1 -0.02,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="38.5" android:startY="38.5" android:endX="71.5" android:endY="71.5">
                <item android:offset="0" android:color="#FF8BEFFF" />
                <item android:offset="0.45" android:color="#FF2E9EEB" />
                <item android:offset="1" android:color="#FF5846DC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- planet gloss -->
    <path android:pathData="M46.2,42.4m-6.3,0a6.3,4.7 0 1,1 12.6,0a6.3,4.7 0 1,1 -12.6,0"
        android:fillColor="#FFFFFF" android:fillAlpha="0.22" />

    <!-- metallic orbit ring (front half) -->
    <group android:rotation="-18" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M88,54 A34,13 0 0 1 20,54"
            android:strokeColor="#F4F9FF"
            android:strokeWidth="4"
            android:strokeLineCap="round" android:fillColor="#00000000" />
    </group>

    <!-- comet on the ring -->
    <group android:rotation="-18" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M70.4,40.4 L78.1,43.3"
            android:strokeColor="#DFF4FF"
            android:strokeWidth="2.5"
            android:strokeLineCap="round" android:fillColor="#00000000" android:strokeAlpha="0.75" />
    </group>
    <path android:pathData="M81.8,32.8m-2.4,0a2.4,2.4 0 1,1 4.8,0a2.4,2.4 0 1,1 -4.8,0"
        android:fillColor="#F2FBFF" />
