<?xml version="1.0" encoding="utf-8"?>
<!-- Stratos VPN launcher foreground: aurora planet + metallic orbit ring. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- stars -->
    <path android:pathData="M18.5,24.5m-1.1,0a1.1,1.1 0 1,1 2.2,0a1.1,1.1 0 1,1 -2.2,0" android:fillColor="#C8DCFF" />
    <path android:pathData="M88.2,21.4m-0.85,0a0.85,0.85 0 1,1 1.7,0a0.85,0.85 0 1,1 -1.7,0" android:fillColor="#AFC6F5" />
